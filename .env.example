# Copy to .env.local and fill in. Never commit real values.

# Public site URL (canonical links, sitemap, social cards)
NEXT_PUBLIC_SITE_URL=https://included.vc

# --- MongoDB (page content and admin accounts) ---
# e.g. mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net
MONGODB_URI=
# Database name (optional; defaults to the one in the URI, else "ascend")
MONGODB_DB=ascend

# --- Cloudinary (page images) ---
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Folder uploads go into
CLOUDINARY_UPLOAD_FOLDER=ascend

# --- Cache refresh ---
# Bearer token for POST /api/revalidate (database webhooks, scripts)
REVALIDATE_SECRET=
